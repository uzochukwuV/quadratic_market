# ─── Quadratic Market Bot Configuration ───────────────────────────────────────────
# Copy this to .env and fill in your keypair paths

# Solana RPC endpoint
RPC_URL=https://api.devnet.solana.com

# Program ID (from devnet-deployment.json)
# Default for devnet: 54kfyBYeASZr4BqyWatkTqmBJTzgQ8XoEs5vaC8wxkRU
PROGRAM_ID=54kfyBYeASZr4BqyWatkTqmBJTzgQ8XoEs5vaC8wxkRU

# Base Mint USDC (from devnet-deployment.json)
# Default for devnet: 8x97aHWPoTY4m9T4tEGDjf4EHYv29nJiX9uEGZHqMyPP
BASE_MINT=8x97aHWPoTY4m9T4tEGDjf4EHYv29nJiX9uEGZHqMyPP

# ─── Keypair Configuration ──────────────────────────────────────────────────────
# You need keypairs to interact with the protocol. Get these from devnet-deployment.json:
#   admin: 4xR9XSbHN1ZwX1izrHr4R4iBJcqc1Pb4GFCufAj44bRX (used for creating markets)
#   oracle: A7iqUH6D5doRL9Fe7kYh9YBPdKoJ9jyhNpRhswSDx4oK (used for settling markets)

# Admin keypair - REQUIRED for creating markets, market groups, etc.
# Must match the admin that deployed the protocol
ADMIN_KEYPAIR_PATH=./path/to/admin-keypair.json

# Oracle keypair - REQUIRED for settling markets (proposing results)
ORACLE_KEYPAIR_PATH=./path/to/oracle-keypair.json

# Optional: combined operator keypair (used if admin/oracle not set)
# OPERATOR_KEYPAIR_PATH=./path/to/operator-keypair.json

# ─── Sports API Configuration ───────────────────────────────────────────────────

# API-Football key (FREE tier: 100 requests/day)
# Sign up at: https://api-football.com/register
# This is used to fetch real-world match data for the frontend
FOOTBALL_API_KEY=

# The-Odds-API key (free tier: 500 requests/month)
# Get your key at: https://the-odds-api.com
ODDS_API_KEY=

# Football leagues to track (comma-separated)
# Supported leagues:
#   soccer_epl - English Premier League
#   soccer_uefa_champs_league - UEFA Champions League
#   soccer_uefa_europa_league - UEFA Europa League
#   soccer_spain_la_liga - Spanish La Liga
#   soccer_germany_bundesliga - German Bundesliga
#   soccer_italy_serie_a - Italian Serie A
#   soccer_france_ligue_one - French Ligue 1
SPORTS=soccer_epl,soccer_uefa_champs_league

# ─── Bot Timing Configuration ───────────────────────────────────────────────────

# How far ahead to create markets (seconds). Default: 24h
MARKET_LOOKAHEAD_SECONDS=86400

# How long after match start to wait before proposing result (seconds). Default: 2h
RESULT_DELAY_SECONDS=7200

# Poll interval for the scheduler (seconds). Default: 5 min
POLL_INTERVAL_SECONDS=300

# ─── Logging ──────────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
