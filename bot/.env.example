# Solana RPC endpoint
RPC_URL=https://api.devnet.solana.com
TXODDS_NETWORK=devnet

# Path to the operator/oracle keypair JSON files (Solana CLI format)
OPERATOR_KEYPAIR_PATH=~/.config/solana/operator.json
ORACLE_KEYPAIR_PATH=~/.config/solana/oracle.json

# On-chain addresses
# PROGRAM_ID is the Quadratic Market program ID.
# BASE_MINT should match the TxLINE devnet mint from the docs.
PROGRAM_ID=4wKXu91KW6EBiecjUUYupQHjab6AULrGCm6hNrWbAvaA
BASE_MINT=4Zao8ocPhmMgq7PdsYWyxvqySMGx7xb9cMftPMkEokRG

# TxLINE API key
TXODDS_API_KEY=your_api_key_here

# Legacy alias kept for older local setups; TXODDS_API_KEY is preferred.
ODDS_API_KEY=
# Comma-separated sport keys to track.
SPORTS=soccer_epl,soccer_uefa_champs_league,basketball_nba

# How far ahead to create markets (seconds). Default: 24h
MARKET_LOOKAHEAD_SECONDS=86400

# How long after match start to wait before proposing result (seconds). Default: 2h
RESULT_DELAY_SECONDS=7200

# Poll interval for the scheduler (seconds)
POLL_INTERVAL_SECONDS=300

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
