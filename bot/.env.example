# ─── Solana Configuration ──────────────────────────────────────────────────────

# Solana RPC endpoint
RPC_URL=https://api.devnet.solana.com

# Program ID - deployed on Solana
PROGRAM_ID=3MsEuMziRKjA1w1WTPeW5NvDUCjGoep2QZ5zBthGq23Z

# Base Mint (set during init_protocol - queried from on-chain)
# BASE_MINT=G9Arp9inP2ocyYUT5NYR9LGie3ARSj3hdFidj3x5Admp

# ─── Operator Key Configuration ─────────────────────────────────────────────────
# Option 1: Base64 encoded private key (recommended for Vercel)
# Get from environment variable OPERATOR_PRIVATE_KEY
# In Vercel: Settings → Environment Variables → OPERATOR_PRIVATE_KEY

# Option 2: File path to wallet JSON (for local development)
OPERATOR_KEY_PATH=/tmp/devnet_wallet.json

# ─── Sports API Configuration ───────────────────────────────────────────────────

# The-Odds-API key (free tier: 500 requests/month)
# Get your key at: https://the-odds-api.com
ODDS_API_KEY=

# Football leagues to track (comma-separated)
# Supported leagues:
#   soccer_epl - English Premier League
#   soccer_uefa_champs_league - UEFA Champions League
#   soccer_uefa_europa_league - UEFA Europa League
#   soccer_spain_la_liga - Spanish La Liga
#   soccer_germany_bundesliga - German Bundesliga
#   soccer_italy_serie_a - Italian Serie A
#   soccer_france_ligue_one - French Ligue 1
SPORTS=soccer_epl,soccer_uefa_champs_league

# ─── Bot Timing Configuration ───────────────────────────────────────────────────

# How far ahead to create markets (seconds). Default: 24h
MARKET_LOOKAHEAD_SECONDS=86400

# How long after match start to wait before proposing result (seconds). Default: 2h
RESULT_DELAY_SECONDS=7200

# Poll interval for the scheduler (seconds). Default: 5 min
POLL_INTERVAL_SECONDS=300

# ─── Logging ──────────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
