# Solana RPC endpoint
RPC_URL=https://api.devnet.solana.com

# Path to the operator/oracle keypair JSON files (Solana CLI format)
OPERATOR_KEYPAIR_PATH=~/.config/solana/operator.json
ORACLE_KEYPAIR_PATH=~/.config/solana/oracle.json

# On-chain addresses (filled after protocol is initialized)
PROGRAM_ID=9H1DCo5QaUtiMne4UH44aefHyv8Xpc8EgZwrshRZqsLC
BASE_MINT=

# Sports API — The-Odds-API (https://the-odds-api.com, free tier: 500 req/month)
ODDS_API_KEY=your_api_key_here
# Comma-separated sport keys to track. Full list: https://the-odds-api.com/sports-odds-data/sports-apis.html
SPORTS=soccer_epl,soccer_uefa_champs_league,basketball_nba

# How far ahead to create markets (seconds). Default: 24h
MARKET_LOOKAHEAD_SECONDS=86400

# How long after match start to wait before proposing result (seconds). Default: 2h
RESULT_DELAY_SECONDS=7200

# Poll interval for the scheduler (seconds)
POLL_INTERVAL_SECONDS=300

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
